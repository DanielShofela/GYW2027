rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'digitalsoutien@gmail.com' &&
        (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // BUG-03: Strictly require settings/event to exist AND registrationsOpen == true
    function areRegistrationsOpen() {
      return exists(/databases/$(database)/documents/settings/event) &&
        get(/databases/$(database)/documents/settings/event).data.registrationsOpen == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\+]+$');
    }

    // BUG-01: Accept canonical reg_p[digits] generated by getRegistrationDocId()
    function isValidRegistration(registrationId, data) {
      return data.keys().hasAll([
        'firstName',
        'lastName',
        'whatsappPhone',
        'normalizedPhone',
        'city',
        'attendanceDays',
        'status',
        'referenceCode',
        'consentAccepted',
        'createdAt'
      ])
      && data.keys().hasOnly([
        'id',
        'firstName',
        'lastName',
        'whatsappPhone',
        'normalizedPhone',
        'city',
        'church',
        'ageCategory',
        'attendanceDays',
        'status',
        'referenceCode',
        'consentAccepted',
        'consentVersion',
        'createdAt',
        'updatedAt'
      ])
      && data.normalizedPhone is string
      && data.normalizedPhone.matches('^\\+[0-9]{8,15}$')
      && registrationId == 'reg_' + data.normalizedPhone.replace('\\+', 'p')
      && registrationId.matches('^reg_p[0-9]{8,15}$')
      && data.firstName is string && data.firstName.size() >= 2 && data.firstName.size() <= 80
      && data.lastName is string && data.lastName.size() >= 2 && data.lastName.size() <= 80
      && data.whatsappPhone is string && data.whatsappPhone.size() >= 8 && data.whatsappPhone.size() <= 30
      && data.city is string && data.city.size() >= 2 && data.city.size() <= 100
      && (!('church' in data) || (data.church is string && data.church.size() <= 120))
      && (!('ageCategory' in data) || (data.ageCategory in ['under_15', '15_17', '18_25', '26_35', 'over_35', 'not_specified']))
      && data.attendanceDays is list && data.attendanceDays.size() >= 1 && data.attendanceDays.size() <= 3
      && data.status == 'confirmed'
      && data.referenceCode is string && data.referenceCode.size() >= 6 && data.referenceCode.size() <= 30
      && data.consentAccepted == true
      && (!('consentVersion' in data) || (data.consentVersion is string && data.consentVersion.size() <= 20));
    }

    match /registrations/{registrationId} {
      // PII Protection: Only verified admins can list, get or delete registrations
      allow get, list, delete: if isAdmin();
      
      // Public registration: anyone can submit if valid, registrations are open, and not an existing duplicate
      // Dual check prevents any duplicate even if an existing user registered under legacy "reg_+"
      allow create: if isValidId(registrationId)
        && areRegistrationsOpen()
        && isValidRegistration(registrationId, incoming())
        && (!exists(/databases/$(database)/documents/registrations/$(registrationId)))
        && (!exists(/databases/$(database)/documents/registrations/$('reg_' + incoming().normalizedPhone)));

      // BUG-05: Admins can update status, church, etc. while protecting immutable fields
      // Supports historical documents that may not have had an internal 'id' property in data
      allow update: if isAdmin() && (
        (!('id' in resource.data) ? (!('id' in incoming()) || incoming().id == registrationId) : incoming().id == resource.data.id) &&
        incoming().normalizedPhone == resource.data.normalizedPhone &&
        incoming().referenceCode == resource.data.referenceCode &&
        incoming().consentAccepted == resource.data.consentAccepted &&
        incoming().createdAt == resource.data.createdAt &&
        incoming().status in ['confirmed', 'cancelled', 'attended']
      );
    }

    match /settings/{settingId} {
      // Event settings (dates, location info, registration open/closed status) are publicly readable
      allow get, list: if true;
      allow write: if isAdmin();

      // BUG-02: Subcollections for chunked logo storage (< 350 KB per document)
      match /logo_assets/{assetId} {
        allow get, list: if true;
        allow write: if isAdmin();

        match /chunks/{chunkId} {
          allow get, list: if true;
          // Protect against excessively large documents or invalid payloads
          allow write: if isAdmin() &&
            incoming().data is string &&
            incoming().data.size() <= 350000 &&
            incoming().chunkIndex is int &&
            incoming().totalChunks is int;
        }
      }
    }

    match /admins/{adminId} {
      allow get, list: if isAdmin();
      // Only the primary superadmin can add or modify admin privileges
      allow write: if isPrimaryAdmin() &&
        incoming().email is string &&
        incoming().role in ['admin', 'superadmin'];
    }
  }
}
